// KAI en Cloudflare: un Worker que sirve la app (dist/) y la API (/api/*).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kai",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Better Auth usa AsyncLocalStorage
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // La API la atiende el Worker; el resto son ficheros estáticos de la app
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "kai", "database_id": "f5f91ed9-ffba-4a17-9775-4a4f4f8f6141", "migrations_dir": "migrations" }
  ],
  // Contenido de los exámenes (preguntas, apuntes, páginas del libro): privado, solo vía API
  "kv_namespaces": [
    { "binding": "CONTENIDO", "id": "0c8cc39a9ccf43768e6c5f3ab33e8500" }
  ],
  // Apuntes que suben los usuarios (privados). Con el tope de worker/limites.js no se pasa de lo gratuito.
  "r2_buckets": [
    { "binding": "APUNTES", "bucket_name": "kai-apuntes" }
  ],
  // Emails al administrador (Email Routing: solo a la dirección verificada)
  "send_email": [
    { "name": "AVISOS", "destination_address": "e3develops@gmail.com" }
  ],
  // Subdominio propio (la web de e3develops.com no se toca); sin la dirección *.workers.dev
  "routes": [{ "pattern": "kai.e3develops.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Cuenta de administrador (puede ver cualquier examen)
    "ADMIN": "e3develops@gmail.com",
    // Examen de pruebas que recibe la cuenta del administrador al crearse
    "EXAMEN_INICIAL": "cap28-taller2",
    // Clave pública del antibots (la secreta va en `wrangler secret put TURNSTILE_SECRET`)
    "TURNSTILE_SITEKEY": "0x4AAAAAAFTH3OphCVdp1Cua"
  },
  // Secretos (no van aquí): BETTER_AUTH_SECRET, TURNSTILE_SECRET, VAPID_PRIVADO → `wrangler secret put …`; en local, .dev.vars
  // Recordatorios diarios (9:00 en Madrid aprox.)
  "triggers": { "crons": ["0 7 * * *"] }
}
